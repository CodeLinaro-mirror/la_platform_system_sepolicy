type hal_audio_default, domain;
hal_server_domain(hal_audio_default, hal_audio)

type hal_audio_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_audio_default)

allow hal_audio_default hal_automotive_vehicle_hwservice:hwservice_manager find;
allow hal_audio_default hal_automotive_vehicle_qti:binder call;
allow hal_audio_default hal_automotive_vehicle_qti:binder transfer;

hal_client_domain(hal_audio_default, hal_allocator)

